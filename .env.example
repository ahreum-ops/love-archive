# Supabase 대시보드 → Project Settings → API 에서 복사. 비워 두면 체험 모드(localStorage)로 돌아간다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 웹 푸시 키. `npx web-push generate-vapid-keys` 로 만든다. 비워 두면 설정의 알림 켜기가 '지원 안 함'으로 보인다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 카카오맵 JavaScript 키 (developers.kakao.com → 앱 → 플랫폼 키). 등록한 도메인에서만 동작
NEXT_PUBLIC_KAKAO_MAP_KEY=
